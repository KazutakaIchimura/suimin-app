# 秘密値（.env.example などのテンプレートはコミットする）
.env
.env.*
!.env.example

# 依存パッケージ
node_modules/

# Claude Code の個人設定（チーム共有の settings.json はコミットする）
.claude/settings.local.json

# OS・エディタ
.DS_Store
Thumbs.db
.vscode/
.idea/

# ログ
*.log

# PR本文の下書き（create-pr スキルが作成。投稿用の一時ファイルなのでコミットしない）
docs/pr/*
!docs/pr/.gitkeep
